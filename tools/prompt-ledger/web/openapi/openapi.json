{
  "openapi": "3.1.1",
  "info": {
    "title": "PromptLedger.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/prompts": {
      "get": {
        "tags": [
          "Prompts"
        ],
        "summary": "Search and filter prompts",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tags",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "reviewed",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "outcome",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/PromptOutcome"
            }
          },
          {
            "name": "sessionId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "starred",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "includeInLog",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "untagged",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "default": "Newest",
              "$ref": "#/components/schemas/PromptSort"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResultOfPromptSummaryDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/prompts/document": {
      "get": {
        "tags": [
          "Prompts"
        ],
        "summary": "Every prompt with full text and annotations, in reading order (session start, then sequence)",
        "parameters": [
          {
            "name": "sessionId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PromptDetailDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/prompts/{id}": {
      "get": {
        "tags": [
          "Prompts"
        ],
        "operationId": "GetPrompt",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PromptDetailDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "patch": {
        "tags": [
          "Prompts"
        ],
        "summary": "Update annotations (null fields are left unchanged)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePromptRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PromptDetailDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Prompts"
        ],
        "summary": "Permanently remove a prompt (e.g. a stray or duplicate capture)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/prompts/{id}/tags": {
      "put": {
        "tags": [
          "Prompts"
        ],
        "summary": "Replace the prompt's tags",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetTagsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PromptDetailDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/tags": {
      "get": {
        "tags": [
          "Tags"
        ],
        "summary": "All tags with usage counts; optional prefix filter for autocomplete",
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TagDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tags/{name}": {
      "patch": {
        "tags": [
          "Tags"
        ],
        "summary": "Rename (merging into an existing tag), recolor or describe a tag",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTagRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TagDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Tags"
        ],
        "summary": "Delete a tag and remove it from all prompts",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/sessions": {
      "get": {
        "tags": [
          "Sessions"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SessionDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/stats": {
      "get": {
        "tags": [
          "Stats"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/sync": {
      "post": {
        "tags": [
          "Actions"
        ],
        "summary": "Import Claude Code transcripts for this repository",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResultDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/export": {
      "post": {
        "tags": [
          "Actions"
        ],
        "summary": "Write PROMPT_LOG.md and the JSONL snapshot",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportResultDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/manual-changes": {
      "get": {
        "tags": [
          "Manual changes"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ManualChangeDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Manual changes"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManualChangeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManualChangeDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/manual-changes/{id}": {
      "put": {
        "tags": [
          "Manual changes"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManualChangeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManualChangeDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Manual changes"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/settings/{key}": {
      "get": {
        "tags": [
          "Settings"
        ],
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "put": {
        "tags": [
          "Settings"
        ],
        "summary": "Store any JSON value (themes, layouts, saved filters)",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonElement"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CaptureSource": {
        "enum": [
          "Hook",
          "TranscriptImport",
          "Manual"
        ]
      },
      "DayCount": {
        "required": [
          "day",
          "prompts",
          "reviewed"
        ],
        "type": "object",
        "properties": {
          "day": {
            "type": "string"
          },
          "prompts": {
            "type": "integer",
            "format": "int32"
          },
          "reviewed": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ExportResultDto": {
        "required": [
          "promptLogPath",
          "snapshotPath"
        ],
        "type": "object",
        "properties": {
          "promptLogPath": {
            "type": "string"
          },
          "snapshotPath": {
            "type": "string"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "JsonElement": { },
      "ManualChangeDto": {
        "required": [
          "id",
          "title",
          "description",
          "reasoning",
          "files",
          "commitSha",
          "relatedPromptId",
          "createdAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "reasoning": {
            "type": [
              "null",
              "string"
            ]
          },
          "files": {
            "type": [
              "null",
              "string"
            ]
          },
          "commitSha": {
            "type": [
              "null",
              "string"
            ]
          },
          "relatedPromptId": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ManualChangeRequest": {
        "required": [
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "reasoning": {
            "type": [
              "null",
              "string"
            ]
          },
          "files": {
            "type": [
              "null",
              "string"
            ]
          },
          "commitSha": {
            "type": [
              "null",
              "string"
            ]
          },
          "relatedPromptId": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          }
        }
      },
      "PagedResultOfPromptSummaryDto": {
        "required": [
          "items",
          "total",
          "page",
          "pageSize"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PromptSummaryDto"
            }
          },
          "total": {
            "type": "integer",
            "format": "int32"
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "PromptDetailDto": {
        "required": [
          "id",
          "sessionId",
          "sessionTitle",
          "sequence",
          "text",
          "submittedAt",
          "source",
          "transcriptUuid",
          "model",
          "responseText",
          "humanReviewed",
          "reviewedAt",
          "comment",
          "rationale",
          "outcome",
          "outcomeNotes",
          "starred",
          "includeInLog",
          "tags",
          "createdAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "sessionId": {
            "type": "string"
          },
          "sessionTitle": {
            "type": [
              "null",
              "string"
            ]
          },
          "sequence": {
            "type": "integer",
            "format": "int32"
          },
          "text": {
            "type": "string"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "$ref": "#/components/schemas/CaptureSource"
          },
          "transcriptUuid": {
            "type": [
              "null",
              "string"
            ]
          },
          "model": {
            "type": [
              "null",
              "string"
            ]
          },
          "responseText": {
            "type": [
              "null",
              "string"
            ]
          },
          "humanReviewed": {
            "type": "boolean"
          },
          "reviewedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "comment": {
            "type": [
              "null",
              "string"
            ]
          },
          "rationale": {
            "type": [
              "null",
              "string"
            ]
          },
          "outcome": {
            "$ref": "#/components/schemas/PromptOutcome"
          },
          "outcomeNotes": {
            "type": [
              "null",
              "string"
            ]
          },
          "starred": {
            "type": "boolean"
          },
          "includeInLog": {
            "type": "boolean"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PromptOutcome": {
        "enum": [
          "Unset",
          "Kept",
          "Changed",
          "Rejected",
          "Mixed"
        ]
      },
      "PromptSort": {
        "enum": [
          "Newest",
          "Oldest"
        ]
      },
      "PromptSummaryDto": {
        "required": [
          "id",
          "sessionId",
          "sequence",
          "text",
          "submittedAt",
          "source",
          "model",
          "humanReviewed",
          "outcome",
          "starred",
          "includeInLog",
          "hasComment",
          "hasResponse",
          "tags"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "sessionId": {
            "type": "string"
          },
          "sequence": {
            "type": "integer",
            "format": "int32"
          },
          "text": {
            "type": "string"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "$ref": "#/components/schemas/CaptureSource"
          },
          "model": {
            "type": [
              "null",
              "string"
            ]
          },
          "humanReviewed": {
            "type": "boolean"
          },
          "outcome": {
            "$ref": "#/components/schemas/PromptOutcome"
          },
          "starred": {
            "type": "boolean"
          },
          "includeInLog": {
            "type": "boolean"
          },
          "hasComment": {
            "type": "boolean"
          },
          "hasResponse": {
            "type": "boolean"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SessionDto": {
        "required": [
          "id",
          "title",
          "cwd",
          "startedAt",
          "promptCount",
          "reviewedCount"
        ],
        "type": "object",
        "properties": {
