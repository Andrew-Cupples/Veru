root = true

[*.cs]
indent_style = space
indent_size = 4
charset = utf-8
insert_final_newline = true
csharp_style_namespace_declarations = file_scoped:warning

# Inline literal arrays read better in tests than hoisted static fields.
[tests/**/*.cs]
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA2007.severity = none

# EF Core migrations are generated code.
[**/Data/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.CA1861.severity = none
