{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "market-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "api"],
