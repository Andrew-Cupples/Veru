{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/prompt-ledger/hooks/ledger-hook.sh\"",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/prompt-ledger/hooks/ledger-hook.sh\"",
            "async": true,
            "timeout": 60
          }
        ]
      }
    ]
  }
}
